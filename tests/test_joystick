from src.potmicro.devices.joystick_device import Joystick
from src.potmicro.devices.device import Device
from src.spotmicro.agent.input import Input
import time
import pygame
import numpy as np
if __name__ == "__main__":
    try:
        my_joy = Joystick(0)
        print(f"Test start on: {my_joy.joy.get_name()}")
        print("Press CTRL+C to stop.\n")
        while True:
            my_joy.update()
            vettore = my_joy.read()
            
            print(f"\rInput Rilevati VX:{vettore[0]:.2f} | VY:{vettore[1]:.2f} | W:{vettore[2]:.2f}", end="")
            
            time.sleep(0.25)
            
    except KeyboardInterrupt:
        print("\n\nTest Terminato dal Terminatore Terminante (anche detto TTTT)")
    except RuntimeError as e:
        print(f"\nError: {e}")
    finally:
        pygame.quit()