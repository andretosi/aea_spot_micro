<sdf version="1.6">
  <model name="box_base">
    <pose>0 0 0.05 0 0 0</pose> <!-- Slightly above the ground -->
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 0.1</size> <!-- A box of 1x1x0.1 meter -->
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>1 1 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1.0</ambient> <!-- Red Color -->
          <diffuse>0.8 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
